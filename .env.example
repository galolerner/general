# Postgres connection string. Use Supabase, Neon, Railway, or local Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/shield?schema=public"

# Auth.js (NextAuth v5). Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32+-byte-string"

# Anthropic API key for the AI battery suggestions.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: override the model used for AI suggestions.
ANTHROPIC_MODEL="claude-sonnet-4-6"
